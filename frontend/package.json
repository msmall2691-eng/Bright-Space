{
  "name": "brightbase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen:types": "cd ../backend && python -c \"import json; from main import app; print(json.dumps(app.openapi(), indent=2))\" > ../frontend/src/api/openapi.json && cd ../frontend && npx openapi-typescript src/api/openapi.json -o src/api/types.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "lucide-react": "^1.41.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.14",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
