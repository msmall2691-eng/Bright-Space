ANTHROPIC_API_KEY=your_anthropic_api_key_here
# AI provider for the non-streaming assistant/drafting features. Defaults to
# anthropic; set to "gemini" to run them on Google Gemini instead (needs
# GEMINI_API_KEY). The streaming Workspace agent chat is still Anthropic-only.
LLM_PROVIDER=anthropic
GEMINI_API_KEY=your_gemini_api_key_here
# Per-tier model overrides (optional — sensible defaults ship in services/llm.py).
# Anthropic: AGENT_MODEL_HAIKU / AGENT_MODEL_SONNET / AGENT_MODEL_OPUS
# Gemini:    GEMINI_MODEL_FAST / GEMINI_MODEL / GEMINI_MODEL_PRO
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Optional: forward a copy of every inbound SMS to this number so on-call
# staff get the message even when BrightBase isn't open. Leave blank to disable.
FORWARD_INBOUND_SMS_TO=

# Database — point to Railway persistent volume
DATABASE_URL=sqlite:////data/brightbase.db

# Email (Gmail + App Password)
SMTP_USER=office@mainecleaningco.com
SMTP_PASS=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# maineclean.co has no MX records — never use it as a From/Reply-To.
FROM_EMAIL=office@mainecleaningco.com
FROM_NAME=Maine Cleaning Co

# Google Calendar — base64-encode your local JSON files:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("google_token.json"))
#   bash:       base64 -w0 google_token.json
GOOGLE_TOKEN_B64=
GOOGLE_CREDENTIALS_B64=
GCAL_RESIDENTIAL_ID=primary
GCAL_COMMERCIAL_ID=primary
GCAL_STR_ID=primary

# Interactive API docs (/docs, /redoc, /openapi.json). BB-SEC-14: OFF wherever
# Railway is running us (detected via RAILWAY_DEPLOYMENT_ID) and ON locally, so
# leave this unset for normal use. Set it to true on Railway to browse the docs
# on a deploy — it publishes every route, parameter and response shape to
# anyone with the URL, so turn it back off afterwards. Set it to false locally
# to rehearse production behaviour.
# ENABLE_API_DOCS=

# How late a background tick may start and still run, in seconds (BB-OPS-02).
# APScheduler's own default is 1 SECOND: a tick whose turn comes up while the
# process is busy is not run late, it is DROPPED as a misfire. 300 is the
# default here. Misfires are counted per tick at GET /api/admin/scheduler.
# TICK_MISFIRE_GRACE_SECONDS=300
